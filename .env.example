# Port the internal HTTP server binds to. Only reachable from pi-agent-server.
PORT=7000
HOST=0.0.0.0

# Workspace mount — where the Pi agent reads/writes files.
WORKSPACE_DIR=/workspace

# Pi SDK agent dir — holds auth.json + models.json + sessions/.
PI_AGENT_DIR=/agent-data

# Path to the system prompt baked into the image (override via volume mount).
SYSTEM_PROMPT_PATH=/app/agent/system-pi.md

# Shared secret between pi-agent-server and this runtime. Required on every request.
INTERNAL_SHARED_TOKEN=change-me-in-prod

# Log level: debug | info | warn | error
LOG_LEVEL=info
